counter = 0;
while (counter < 5) {
    print(counter);
    counter = counter + 1;
}

num = 10;
while (num > 0) {
    print(num);
    num = num - 1;
}

sum = 0;
i = 1;
while (i <= 10) {
    sum = sum + i;
    i = i + 1;
}
print(sum);

done = false;
count = 0;
while (not done) {
    print(count);
    count = count + 1;
    if (count >= 5) {
        done = true;
    }
}

for (j = 0; j < 5; j = j + 1) {
    print(j);
}

for (k = 10; k > 0; k = k - 1) {
    print(k);
}

for (m = 0; m < 10; m = m + 2) {
    print(m);
}

factorial = 1;
for (n = 1; n <= 5; n = n + 1) {
    factorial = factorial * n;
}
print(factorial);

outer = 0;
while (outer < 3) {
    inner = 0;
    while (inner < 3) {
        result = outer * 10 + inner;
        print(result);
        inner = inner + 1;
    }
    outer = outer + 1;
}

for (row = 1; row <= 3; row = row + 1) {
    for (col = 1; col <= 3; col = col + 1) {
        product = row * col;
        print(product);
    }
}

for (p = 0; p < 20; p = p + 1) {
    if (p > 10) {
        print(p);
    }
}

x = 0;
y = 10;
while ((x < 5) and (y > 5)) {
    print(x);
    print(y);
    x = x + 1;
    y = y - 1;
}

base = 2;
exponent = 5;
power = 1;
for (e = 0; e < exponent; e = e + 1) {
    power = power * base;
}
print(power);

a = 0;
b = 10;
while (a < b) {
    print(a);
    print(b);
    a = a + 2;
    b = b - 1;
}

for (t = 0; t < 10; t = t + 1) {
    output = t > 5 ? "High" : "Low";
    print(output);
}

for (i = 1; i <= 5; i = i + 1) {
    if (i > 2) {
        for (j = 1; j <= 3; j = j + 1) {
            val = i + j;
            print(val);
        }
    }
}

total = 0;
num = 1;
while (num <= 5) {
    total = total + (num * num);
    num = num + 1;
}
print(total);
